{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "router.backend.main:app",
                "--host", "127.0.0.1",
                "--port", "8000"
            ],
            "cwd": "${workspaceFolder}/source_code",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/source_code;${workspaceFolder}/source_code/router/backend"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
